// wayball — live MLB score module. Merge into ~/.config/waybar/config.
//
// Replace <WAYBALL_DIR> with the absolute path to this repo and TOR with your
// team's abbreviation. `./install.sh` prints this block with the paths already
// filled in.
//
// 1. Add "custom/mlb" to each output block's "modules-right" array.
// 2. Add this object to each output block.
"custom/mlb": {
    "exec": "<WAYBALL_DIR>/.venv/bin/python <WAYBALL_DIR>/wayball.py --team TOR",
    "return-type": "json",
    "restart-interval": 5,
    "tooltip": true,
    "on-click": "<WAYBALL_DIR>/gameday.sh TOR"
}
